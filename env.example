# Все поля необязательны. .env нужно экспортировать перед OpenCode; автозагрузки нет.
# Для запросов подключены Demo и RPC; остальные ключи пока только проверяются.

# Бесплатные
# https://www.coingecko.com/en/api
COINGECKO_DEMO_API_KEY=
# Context7: повышенные лимиты, нужна настройка MCP. https://context7.com/dashboard
CONTEXT7_API_KEY=

# Базовые
# HTTPS RPC нужной сети; возможна оплата провайдеру.
CR_RPC_URL=

# Опциональные
# Квоты и стоимость зависят от плана; ключ не разрешает платные вызовы.
# Exa: после авторизации включается платный agent_run — ограничить tools поиском/чтением.
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
DUNE_API_KEY=
THEGRAPH_API_KEY=
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
MOBULA_API_KEY=

# Платные планы и наборы данных
# CryptoRank: funding/unlocks от Pro. GoldRush: trial/платные планы.
CRYPTORANK_API_KEY=
GOLDRUSH_API_KEY=
COINGECKO_PRO_API_KEY=
